        return bookingSystems;
    }
    public synchronized void bookingSystem(int bookingSystemId)
    {
        // Implementation for synchronized booking system
        ArrayList<BookingSystem> isAvailable=getBookingSystems();
        Map<Integer, Boolean> isAvailableMap = isAvailable.stream()
                .collect(Collectors.toMap(BookingSystem::getSeatManager, BookingSystem::getCheckAvailability));
        // Process the booking system with the given ID
        System.out.println("Booking system " + bookingSystemId + " is available: " + isAvailableMap.get(bookingSystemId));
    }
}
public class TicketDataBase{
    public static void main(String[] args)
    {
        TicketBookingSystem tbs=new TicketBookingSystem();
        Thread t1=new Thread(()->
            tbs.bookingSystem(1));
        t1.start();
        try{
            t1.join();
        }catch(InterruptedException e)
        {
            System.out.println(e.getMessage());
        }
        Thread t2=new Thread(()->tbs.bookingSystem(23));
        t2.start();
    }
}
