package SynchronizedMethodPackage;
import java.util.ArrayList;
import java.util.Map;
import java.util.stream.Collectors;
class TicketBookingSystem{
    public static ArrayList<BookingSystem> getBookingSystems()
    {
        BookingSystem bs1=new BookingSystem(1,true);
        BookingSystem bs2=new BookingSystem(2,true);
        BookingSystem bs3=new BookingSystem(3,true);
        BookingSystem bs4=new BookingSystem(4,true);
        BookingSystem bs5=new BookingSystem(5,true);
        BookingSystem bs6=new BookingSystem(6,false);
        BookingSystem bs7=new BookingSystem(7,true);
        BookingSystem bs8=new BookingSystem(8,true);
        BookingSystem bs9=new BookingSystem(9,true);
        BookingSystem bs10=new BookingSystem(10,true);
        BookingSystem bs11=new BookingSystem(11,true);
        BookingSystem bs12=new BookingSystem(12,true);
        BookingSystem bs13=new BookingSystem(13,false);
        BookingSystem bs14=new BookingSystem(14,true);
        BookingSystem bs15=new BookingSystem(15,false);
        BookingSystem bs16=new BookingSystem(16,true);
        BookingSystem bs17=new BookingSystem(17,true);
        BookingSystem bs18=new BookingSystem(18,false);
        BookingSystem bs19=new BookingSystem(19,true);
        BookingSystem bs20=new BookingSystem(20,false);
        BookingSystem bs21=new BookingSystem(21,true);
        BookingSystem bs22=new BookingSystem(22,true);
        BookingSystem bs23=new BookingSystem(23,false);
        BookingSystem bs24=new BookingSystem(24,true);
        BookingSystem bs25=new BookingSystem(25,true);
        BookingSystem bs26=new BookingSystem(26,true);
        ArrayList<BookingSystem> bookingSystems=new ArrayList<>();
        bookingSystems.add(bs1);
        bookingSystems.add(bs2);
        bookingSystems.add(bs3);
        bookingSystems.add(bs4);
        bookingSystems.add(bs5);
